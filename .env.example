# Browser map. Enable Maps JavaScript API and Places API, and restrict by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=

# Server geocoding for a future iOS client. Can be the same Google key with Geocoding API enabled.
GOOGLE_MAPS_API_KEY=

TICKETMASTER_API_KEY=
GEMINI_API_KEY=
VALHALLA_URL=https://valhalla1.openstreetmap.de
GEMMA_MODEL=gemma-4-26b-a4b-it
NWS_USER_AGENT=MapMiami/1.0 (local development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
